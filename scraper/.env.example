# Backend the scraper talks to
BACKEND_URL=http://localhost:4000
# Must match SCRAPER_API_KEY in backend/.env
SCRAPER_API_KEY=change-me

# DVSA booking site (change-test journey). Configurable in case URLs change.
DVSA_LOGIN_URL=https://driverpracticaltest.dvsa.gov.uk/login

# Polling interval in seconds (the brief asks for 60s).
POLL_INTERVAL_SECONDS=60

# Run the browser headless (true) or visible (false, useful for debugging).
HEADLESS=true

# Set to "true" to run against the built-in mock site instead of the real DVSA
# site. Use this for local development and testing.
USE_MOCK=true
# When USE_MOCK=true, this local URL is scraped instead of the DVSA site.
MOCK_URL=http://localhost:8000
