# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Supabase ----
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service role key (server-side only, NEVER ship to the mobile app)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Encryption ----
# 32-byte key (64 hex chars) used to encrypt DVSA passwords at rest.
# Generate one with: openssl rand -hex 32
CREDENTIALS_ENCRYPTION_KEY=

# ---- Firebase Cloud Messaging ----
# Path to the Firebase service account JSON downloaded from the Firebase console.
# (Project settings -> Service accounts -> Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ---- Stripe (premium upgrade - mocked for now) ----
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# ---- Shared secret used by the scraper to call the backend ----
SCRAPER_API_KEY=change-me
